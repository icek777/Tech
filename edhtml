<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zestawy komputerowe LIPIEC 2026 — ZESTAWOMAT</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>

  :root{
    --bg: #0b0f1a;
    --bg-soft: #0e1424;
    --surface: #141b2d;
    --surface-2: #1b2438;
    --border: #29324c;
    --border-soft: #202944;
    --text: #edeff5;
    --text-dim: #8b94ac;
    --text-faint: #545e7a;
    --copper: #d68a4c;
    --copper-light: #eeb37f;
    --copper-dim: #8a5a34;
    --cyan: #3fe0c8;
    --cyan-dim: #1f7a6c;
    --amd: #e0603f;
    --intel: #3f8fe0;

    --font-display: 'Chakra Petch', sans-serif;
    --font-body: 'Manrope', sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }

  *{ box-sizing:border-box; margin:0; padding:0; }
  html{ scroll-behavior:smooth; }
  body{
    background: var(--bg); color: var(--text); font-family: var(--font-body); line-height:1.55;
    background-image:
      radial-gradient(ellipse 900px 500px at 10% -5%, rgba(214,138,76,0.08), transparent 60%),
      radial-gradient(ellipse 700px 500px at 100% 20%, rgba(63,224,200,0.06), transparent 60%);
  }
  a{ color:inherit; text-decoration:none; }
  h1,h2,h3,.mono,.eyebrow{ font-family: var(--font-display); }
  .mono{ font-family: var(--font-mono); }
  ::selection{ background: var(--copper); color:#0b0f1a; }
  .wrap{ max-width: 1180px; margin:0 auto; padding: 0 28px; }

  /* NAV */
  header{ position: sticky; top:0; z-index:60; backdrop-filter: blur(14px); background: rgba(11,15,26,0.75); border-bottom:1px solid var(--border-soft); }
  nav{ display:flex; align-items:center; justify-content:space-between; padding: 16px 0; }
  .logo{ display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-weight:700; font-size:19px; }
  .logo span{ color: var(--copper-light); }
  nav ul{ display:flex; gap:30px; list-style:none; }
  nav ul li a{ font-size:13.5px; color: var(--text-dim); font-weight:600; transition: color .2s; }
  nav ul li a:hover{ color: var(--text); }
  .nav-cta{ background: var(--copper); color:#17110a; font-weight:700; padding:9px 18px; border-radius:4px; font-size:13px; font-family: var(--font-display); }
  @media (max-width: 780px){ nav ul{ display:none; } }

  /* ARTICLE HERO */
  .art-hero{ padding: 56px 0 40px; border-bottom: 1px solid var(--border-soft); }
  .breadcrumb{ font-family: var(--font-mono); font-size:11.5px; color: var(--text-faint); margin-bottom:18px; letter-spacing: .5px; }
  .breadcrumb span{ color: var(--cyan); }
  .art-badge{
    display:inline-flex; align-items:center; gap:8px; background: var(--surface); border:1px solid var(--border);
    padding: 6px 14px; border-radius: 999px; font-family: var(--font-mono); font-size:11.5px; color: var(--copper-light);
    letter-spacing: 1px; margin-bottom: 22px;
  }
  .art-badge::before{ content:""; width:7px; height:7px; background: var(--copper-light); border-radius:50%; box-shadow: 0 0 8px var(--copper-light); }
  .art-hero h1{ font-size: 44px; line-height:1.12; font-weight:700; letter-spacing:-.5px; max-width: 760px; margin-bottom: 20px; }
  .art-meta{ display:flex; gap: 22px; flex-wrap:wrap; align-items:center; margin-bottom: 26px; }
  .art-meta .who{ display:flex; align-items:center; gap:10px; }
  .avatar{ width:34px; height:34px; border-radius:50%; background: linear-gradient(135deg, var(--copper-light), var(--cyan-dim)); flex-shrink:0; }
  .art-meta .name{ font-size:13.5px; font-weight:700; }
  .art-meta .sub{ font-size:11.5px; color: var(--text-faint); font-family: var(--font-mono); }
  .art-meta .stat{ font-size: 12.5px; color: var(--text-dim); font-family: var(--font-mono); }
  .art-lead{ max-width: 700px; color: var(--text-dim); font-size:15.5px; }
  .art-lead p{ margin-bottom: 14px; }
  .art-lead strong{ color: var(--text); }
  .callout{
    margin-top: 24px; max-width: 700px; background: var(--surface); border-left: 3px solid var(--cyan);
    border-radius: 0 8px 8px 0; padding: 16px 20px; font-size: 13.5px; color: var(--text-dim);
  }
  .callout b{ color: var(--cyan); }

  /* LAYOUT: rail + list */
  .article-body{ padding: 54px 0 90px; display:grid; grid-template-columns: 110px 1fr; gap: 40px; align-items: start; }
  .price-rail{ position: sticky; top: 90px; display:flex; flex-direction:column; align-items:center; }
  .price-rail .rail-line{ width:2px; flex:1; background: linear-gradient(180deg, var(--copper), var(--cyan)); border-radius:2px; min-height: 320px; position:relative; }
  .price-rail .rail-label{ writing-mode: vertical-rl; font-family: var(--font-mono); font-size:10.5px; color: var(--text-faint); letter-spacing:2px; margin-bottom: 14px; text-transform:uppercase; }
  @media (max-width: 900px){ .article-body{ grid-template-columns: 1fr; } .price-rail{ display:none; } }

  .filter-row{ display:flex; gap:10px; margin-bottom: 28px; flex-wrap:wrap; }
  .filter-row button{
    background: transparent; border:1px solid var(--border); color: var(--text-dim); font-family: var(--font-mono);
    font-size:12px; padding: 9px 16px; border-radius: 999px; cursor:pointer; transition: all .2s ease;
    display:flex; align-items:center; gap:7px;
  }
  .filter-row button .dot{ width:7px; height:7px; border-radius:50%; }
  .filter-row button.active{ background: var(--surface-2); border-color: var(--text-dim); color: var(--text); }
  .filter-row button:hover{ border-color: var(--copper-dim); }

  .build-list{ display:flex; flex-direction:column; gap: 16px; }

  .build-card{
    background: var(--surface); border:1px solid var(--border); border-radius: 12px; overflow:hidden;
    transition: border-color .2s ease;
  }
  .build-card:hover{ border-color: var(--border-soft); }
  .build-head{
    display:flex; align-items:center; justify-content:space-between; padding: 20px 24px; cursor:pointer; gap: 20px;
  }
  .build-head-left{ display:flex; align-items:center; gap: 18px; }
  .platform-chip{
    font-family: var(--font-mono); font-size: 10.5px; padding: 4px 10px; border-radius: 5px; letter-spacing:1px;
    flex-shrink:0;
  }
  .platform-chip.amd{ background: rgba(224,96,63,0.15); color: #f0906f; border:1px solid rgba(224,96,63,0.35); }
  .platform-chip.intel{ background: rgba(63,143,224,0.15); color: #7fb4f0; border:1px solid rgba(63,143,224,0.35); }
  .build-price{ font-family: var(--font-display); font-size: 22px; font-weight:700; color: var(--copper-light); min-width: 108px; }
  .build-summary h3{ font-size: 15px; font-weight:600; margin-bottom: 3px; }
  .build-summary .subtxt{ font-size: 12.5px; color: var(--text-faint); font-family: var(--font-mono); }
  .expand-btn{
    width: 30px; height: 30px; border-radius:50%; border:1px solid var(--border); display:flex; align-items:center;
    justify-content:center; flex-shrink:0; transition: transform .3s ease, border-color .2s;
  }
  .build-card.open .expand-btn{ transform: rotate(45deg); border-color: var(--copper); }

  .build-detail{ max-height:0; overflow:hidden; transition: max-height .35s ease; border-top: 1px solid transparent; }
  .build-card.open .build-detail{ max-height: 700px; border-top: 1px solid var(--border); }
  .build-detail-inner{ padding: 22px 24px 26px; display:grid; grid-template-columns: 1fr 220px; gap: 30px; }
  @media (max-width: 640px){ .build-detail-inner{ grid-template-columns: 1fr; } }

  table.parts{ width:100%; border-collapse:collapse; }
  table.parts tr{ border-bottom: 1px dashed var(--border-soft); }
  table.parts tr:last-child{ border-bottom:none; }
  table.parts td{ padding: 9px 0; font-size: 13.5px; }
  table.parts td.k{ font-family: var(--font-mono); font-size:10.5px; color: var(--text-faint); letter-spacing:1px; text-transform:uppercase; width: 118px; vertical-align: top; padding-top:10px; }
  table.parts td.v{ font-weight:600; }
  table.parts td.p{ text-align:right; font-family: var(--font-mono); color: var(--text-dim); font-size:12.5px; }

  .side-panel{ display:flex; flex-direction:column; gap: 16px; }
  .total-box{ background: var(--bg-soft); border:1px solid var(--border); border-radius:8px; padding: 16px 18px; text-align:center; }
  .total-box .lbl{ font-family: var(--font-mono); font-size:10.5px; color: var(--text-faint); letter-spacing:1.5px; margin-bottom:6px; text-transform:uppercase; }
  .total-box .amt{ font-family: var(--font-display); font-size:24px; font-weight:700; }
  .use-for{ font-size:12px; color: var(--text-dim); }
  .use-for .lbl{ font-family: var(--font-mono); font-size:10.5px; color: var(--text-faint); letter-spacing:1.5px; margin-bottom:8px; text-transform:uppercase; display:block; }
  .use-for span.tag{ display:inline-block; background: var(--surface-2); border:1px solid var(--border); padding:4px 10px; border-radius:999px; font-size:11.5px; margin: 0 5px 5px 0; }
  .buy-btn{
    background: linear-gradient(135deg, var(--copper-light), var(--copper)); color:#1a1207; font-weight:700;
    text-align:center; padding: 11px; border-radius:6px; font-family: var(--font-display); font-size:13px;
  }

  /* video callout */
  .video-box{
    margin-top: 44px; background: var(--surface); border:1px solid var(--border); border-radius:14px;
    padding: 30px; display:flex; gap:26px; align-items:center;
  }
  .play-circle{
    width:64px; height:64px; border-radius:50%; background: var(--surface-2); border:1px solid var(--border);
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .video-box h3{ font-size:16px; margin-bottom:6px; }
  .video-box p{ font-size:13px; color: var(--text-dim); }
  @media (max-width:600px){ .video-box{ flex-direction:column; text-align:center; } }

  /* author + newsletter */
  .author-band{
    margin-top: 60px; background: linear-gradient(135deg, var(--surface-2), var(--surface)); border:1px solid var(--border);
    border-radius: 16px; padding: 40px; display:flex; justify-content:space-between; align-items:center; gap: 30px; flex-wrap:wrap;
  }
  .author-info{ display:flex; gap:18px; align-items:center; }
  .author-avatar{ width:56px; height:56px; border-radius:50%; background: linear-gradient(135deg, var(--copper-light), var(--cyan-dim)); flex-shrink:0; }
  .author-info h3{ font-size:16px; margin-bottom:4px; }
  .author-info p{ font-size:13px; color: var(--text-dim); max-width: 400px; }
  .cta-form{ display:flex; gap:10px; }
  .cta-form input{ background: var(--bg); border:1px solid var(--border); border-radius:5px; padding:12px 15px; color:var(--text); font-size:13.5px; width:210px; }
  @media (max-width:600px){ .cta-form{ width:100%; } .cta-form input{ width:100%; } }

  /* tags + footer */
  .tags-row{ display:flex; flex-wrap:wrap; gap:8px; margin-top: 40px; }
  .tags-row span{ font-family: var(--font-mono); font-size:11px; color: var(--text-faint); border:1px solid var(--border-soft); padding:5px 12px; border-radius:999px; }

  footer{ border-top:1px solid var(--border-soft); padding: 40px 0 30px; margin-top: 40px; }
  .footer-inner{ display:flex; justify-content:space-between; flex-wrap:wrap; gap:18px; align-items:center; }
  .footer-links{ display:flex; gap:24px; list-style:none; }
  .footer-links a{ font-size:12.5px; color: var(--text-dim); }
  .footer-links a:hover{ color: var(--copper-light); }
  .footer-copy{ font-size:11.5px; color: var(--text-faint); font-family: var(--font-mono); }

  a:focus-visible, button:focus-visible, input:focus-visible{ outline: 2px solid var(--cyan); outline-offset:2px; }
</style>
</head>
