      parts:[["CPU","Intel Core Ultra 7 265K","1780 zł"],["Płyta gł.","Z890 WiFi7","1140 zł"],["RAM","32GB (2×16) DDR5 6400 CL32","560 zł"],
      ["GPU","GeForce RTX 5080 16GB","6100 zł"],["Dysk","2TB NVMe Gen4","560 zł"],["Chłodzenie","AIO 240mm ARGB","380 zł"],
      ["Zasilacz","850W 80+ Gold","560 zł"],["Obudowa","premium ARGB","770 zł"]],
      total:"12 380 zł", use:["4K wysokie/ultra","Streaming + montaż"] },

    { platform:"amd", price:"15 940 zł", title:"Ryzen 9 9900X / 64GB DDR5 / RTX 4080 Super 16GB", sub:"Flagowiec bez kompromisów",
      parts:[["CPU","AMD Ryzen 9 9900X","2080 zł"],["Płyta gł.","X670E Gaming","1480 zł"],["RAM","64GB (2×32) DDR5 6000 CL30","920 zł"],
      ["GPU","GeForce RTX 4080 Super 16GB","5950 zł"],["Dysk","2TB NVMe Gen4 + 2TB HDD","950 zł"],["Chłodzenie","AIO 360mm ARGB","520 zł"],
      ["Zasilacz","850W 80+ Platinum","640 zł"],["Obudowa","premium, panel szkło","1400 zł"]],
      total:"15 940 zł", use:["4K ultra","Streaming + montaż + gry"] }
  ];

  const list = document.getElementById("buildList");

  function render(filter){
    list.innerHTML = "";
    builds.filter(b => filter === "all" || b.platform === filter).forEach((b, i) => {
      const card = document.createElement("div");
      card.className = "build-card";
      const rows = b.parts.map(p => `<tr><td class="k">${p[0]}</td><td class="v">${p[1]}</td><td class="p">${p[2]}</td></tr>`).join("");
      const tags = b.use.map(u => `<span class="tag">${u}</span>`).join("");
      card.innerHTML = `
        <div class="build-head">
          <div class="build-head-left">
            <span class="platform-chip ${b.platform}">${b.platform.toUpperCase()}</span>
            <div class="build-price mono">${b.price}</div>
            <div class="build-summary">
              <h3>${b.title}</h3>
              <div class="subtxt">${b.sub}</div>
            </div>
          </div>
          <div class="expand-btn">
            <svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 0v14M0 7h14" stroke="#8b94ac" stroke-width="1.6"/></svg>
          </div>
        </div>
        <div class="build-detail">
          <div class="build-detail-inner">
            <table class="parts">${rows}</table>
            <div class="side-panel">
              <div class="total-box">
                <div class="lbl">Suma</div>
                <div class="amt mono">${b.total}</div>
              </div>
              <div class="use-for">
                <span class="lbl">Do czego</span>
                ${tags}
              </div>
              <div class="buy-btn">Lista zakupowa →</div>
            </div>
          </div>
        </div>
      `;
      card.querySelector(".build-head").addEventListener("click", () => card.classList.toggle("open"));
      list.appendChild(card);
    });
  }

  document.querySelectorAll("#filterRow button").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll("#filterRow button").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      render(btn.dataset.f);
    });
  });

  render("all");
</script>

</body>
</html>
